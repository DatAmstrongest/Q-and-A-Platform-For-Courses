# Database configuration for PostgreSQL (running in container called "database-server-dab-p2-7527ac26-9059-45ad-9e1f-ad3f5c4b0a7d")
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database

# Database configuration for Flyway (used for database migrations)
FLYWAY_USER=username
FLYWAY_PASSWORD=password
FLYWAY_URL=jdbc:postgresql://database-server-dab-p2-7527ac26-9059-45ad-9e1f-ad3f5c4b0a7d:5432/database

# Database configuration for PostgreSQL driver
PGUSER=username
PGPASSWORD=password
PGHOST=database-server-dab-p2-7527ac26-9059-45ad-9e1f-ad3f5c4b0a7d
PGPORT=5432
PGDATABASE=database

# Deno cache location (avoid reloading depedencies over and over)
DENO_DIR=/app-cache